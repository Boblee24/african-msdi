# ─────────────────────────────────────────────────────────────────────────────
# African MSDI — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
#
# 1. Create a Neon project at https://neon.tech
# 2. From your Neon dashboard: Project → Connection Details → Connection string
# 3. Copy the connection string (it starts with postgres://...)
# 4. Paste it below, then rename this file to .env.local
#
# ─────────────────────────────────────────────────────────────────────────────

DATABASE_URL=postgres://username:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
